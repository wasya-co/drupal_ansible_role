
services:

  piousbox_com:
    image: piousbox/php83:0.0.2
    container_name: {{ appliance_slug }}
    depends_on:
      - mysql
    volumes:
      - type: bind
        source: ./volumes/{{ appliance_slug }}
        target: /var/www/html
      - type: bind
        source: ./_bashrc
        target: /root/.bashrc
      - type: bind
        source: ./000-default-drupal.conf
        target: /etc/apache2/sites-available/000-default.conf
    ports:
      - {{ app_port }}:80
    restart: 'unless-stopped'
    extra_hosts:
      - "host.docker.internal:host-gateway"

  mysql:
    image: mysql:8.0
    cap_add:
      - SYS_NICE
    command:
      - '--default-authentication-plugin=mysql_native_password'
      - '--skip-log-bin'
    container_name: mysql
    restart: 'unless-stopped'
    ports:
      - "{{ mysql_host_port }}:3306"
    environment:
      MYSQL_ROOT_PASSWORD: {{ mysql_root_password }}
      MYSQL_DATABASE: {{ mysql_db }}
      MYSQL_USER: {{ mysql_user }}
      MYSQL_PASSWORD: {{ mysql_password }}
    volumes:
      - mysql_data:/var/lib/mysql

volumes:
  mysql_data:
